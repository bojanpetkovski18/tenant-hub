# Copy to .env and fill in. Never commit .env.
# Placeholders only. Variables are added here by the milestone that introduces them.

# --- Database (docker compose and API) ---
POSTGRES_DB=tenant_hub
POSTGRES_USER=tenant_hub
POSTGRES_PASSWORD=change-me
# Port 5434 on the host so it does not clash with the owner's other projects.
# The host is "db" inside docker compose and "localhost" when running the API on the host.
ConnectionStrings__Database=Host=localhost;Port=5434;Database=tenant_hub;Username=tenant_hub;Password=change-me

# --- App ---
ASPNETCORE_ENVIRONMENT=Development
Database__MigrateOnStartup=true
Seed__Enabled=true

# --- Email (M05): Smtp | Disabled. Mailpit listens on 1025 (SMTP) and 8025 (web UI) in development. ---
Email__Mode=Smtp
Email__SmtpHost=localhost
Email__SmtpPort=1025
Email__From=no-reply@tenanthub.example

# --- Demo users (M02; seeded only if set) ---
DEMO_PASSWORD=change-me-min-10-chars

# --- Demo mode (M09; public demo only) ---
DEMO_MODE=false
DEMO_RESET_INTERVAL_HOURS=6
