# Copy to .env and fill in. Never commit .env.
# Placeholders only. Variables are added here by the milestone that introduces them.

# --- Database (docker compose and API) ---
POSTGRES_DB=tenant_hub
# The schema owner: runs the migrations (M14, D038).
POSTGRES_USER=tenant_hub
POSTGRES_PASSWORD=change-me
# The API's own database user, which row-level security applies to. It is created (or its password updated) at
# startup from ConnectionStrings__Database when Database__MigrateOnStartup is on, and must differ from the owner.
APP_DB_USER=tenant_hub_app
APP_DB_PASSWORD=change-me-too
# Port 5434 on the host so it does not clash with the owner's other projects.
# The host is "db" inside docker compose and "localhost" when running the API on the host.
# The API runs as APP_DB_USER; DatabaseAdmin (the owner) is used only to migrate and provision at startup.
ConnectionStrings__Database=Host=localhost;Port=5434;Database=tenant_hub;Username=tenant_hub_app;Password=change-me-too
ConnectionStrings__DatabaseAdmin=Host=localhost;Port=5434;Database=tenant_hub;Username=tenant_hub;Password=change-me

# --- App ---
ASPNETCORE_ENVIRONMENT=Development
Database__MigrateOnStartup=true
Seed__Enabled=true
# Where the web app is reached; invitation links in emails start with it. The dev server in development.
App__PublicUrl=http://localhost:4200

# --- Email (M05): Smtp | Disabled. Mailpit listens on 1025 (SMTP) and 8025 (web UI) in development. ---
Email__Mode=Smtp
Email__SmtpHost=localhost
Email__SmtpPort=1025
Email__From=no-reply@tenanthub.example

# --- Photos (M19): the directory photo files are stored in; relative to where the API starts (git-ignored there).
# The production image uses /app/data/files on a volume. ---
Files__Root=data/files

# --- Webhooks (M21): endpoints must be public https addresses. In Development only, one local receiver may be named
# here (node tools/webhook-receiver.mjs listens on it); the setting is ignored in every other environment. ---
# Webhooks__AllowedReceiver=http://127.0.0.1:5099/

# --- Demo users (M02): seeded on start when Seed__Enabled=true and this is set. It must satisfy the password rules
# (10+ characters with upper and lower case, a digit and a symbol). Pick your own for anything public. ---
DEMO_PASSWORD=Change-Me-Demo-2026!

# --- Demo mode (M09; public demo only) ---
DEMO_MODE=false
DEMO_RESET_INTERVAL_HOURS=6

# --- Full stack (M11): docker compose up --build --wait runs the production image with PostgreSQL and Mailpit.
# The app container composes its own connection string and SMTP host; these set what the host sees. ---
STACK_APP_PORT=8080
STACK_MAILPIT_UI_PORT=8026
STACK_PUBLIC_URL=http://localhost:8080

# --- Behind a hosting proxy (M12): trust its X-Forwarded-For/Proto so rate limits see the client and cookies the
# scheme. Off unless the proxy's networks are listed; 0.0.0.0/0 only where the proxy is the app's only way in. ---
# ForwardedHeaders__Enabled=true
# ForwardedHeaders__KnownNetworks__0=10.0.0.0/8
